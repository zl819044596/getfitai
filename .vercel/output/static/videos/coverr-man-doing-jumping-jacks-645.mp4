 de inmediato. Ya sea para una campaña de marketing, un vídeo de YouTube o cualquier otro proyecto, nuestro sencillo proceso de descarga te garantiza que podrás empezar a editar de inmediato. Disfruta de la calidad de nuestros vídeos.\u003C/p>","title":"Gratis Clásico Vídeos de archivo","description":"Explora y descarga más de 106 preciosos clips de vídeo y secuencias de Clásico para tu sitio web o cualquier proyecto. Descarga gratis vídeos de Clásico libres de derechos de alta calidad en HD y 4K."},"pt":{"name":"Vintage","slug":"vintage"},"fr":{"name":"Vintage","slug":"vintage"},"nl":{"name":"Vintage","slug":"vintage"},"it":{"name":"Vintage","slug":"vintage"},"de":{"name":"Vintage","slug":"vintage"}}},"slug":"vintage"}],"tags":["stereo","receiver","manual","control","man","vintage"],"defaultVariant":{"id":"bd53aea1c4b6","createdAt":"2024-02-27T08:09:08.205Z","updatedAt":"2024-02-27T08:09:08.205Z","videoId":"0771i6CWdh","key":"default","aspectRatio":"16:9","status":"done","renditions":[{"id":"898129d4e228","createdAt":"2024-02-27T08:10:07.156Z","updatedAt":"2024-02-27T08:10:07.156Z","variantId":"bd53aea1c4b6","type":"fhd","size":4131054,"width":1920,"height":1080,"isPlus":true,"url":"https://cdn.coverr.co/videos/coverr-premium-close-up-of-a-man-and-a-manual-stereo-receiver-3901/1080p.mp4","codec":"h264","bitrate":4438946},{"id":"974667d4f3d3","createdAt":"2024-02-27T08:09:50.231Z","updatedAt":"2024-02-27T08:09:50.231Z","variantId":"bd53aea1c4b6","type":"hd","size":2277077,"width":1280,"height":720,"isPlus":true,"url":"https://cdn.coverr.co/videos/coverr-premium-close-up-of-a-man-and-a-manual-stereo-receiver-3901/720p.mp4","codec":"h264","bitrate":2445435},{"id":"a7601fa92fce","createdAt":"2024-02-27T08:10:20.609Z","updatedAt":"2024-02-27T08:10:20.609Z","variantId":"bd53aea1c4b6","type":"original","size":23947555,"width":3840,"height":2160,"isPlus":true,"url":"https://cdn.coverr.co/videos/coverr-premium-close-up-of-a-man-and-a-manual-stereo-receiver-3901/original.mp4