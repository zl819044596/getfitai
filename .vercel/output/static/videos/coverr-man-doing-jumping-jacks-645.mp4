 endless inspiration. Available for personal and commercial use with no attribution needed, our videos are ideal for your next creative endeavor. Elevate your projects with a few clicks – explore, select, and transform your vision into reality.","titleHTML":"Unleash Creativity with Our Free Stock Video Library"},"music_banner":{"cta":"Check it out","title":"Try coverr music","description":"Never worry about rights and royalty"},"search_input":{"recents":"Recents","empty_state":"Start typing to see suggestions...","placeholder":{"image":"Search for an image","music":"Search for a music","video":"Search for a video","ai_sfx":"Describe SFX idea","ai_image":"Describe image idea","ai_music":"Describe music idea","ai_video":"Describe video idea","ai_voiceover":"Write voiceover text"},"recent_searches":"Recent searches","generate_ai_video":"Generate AI Video","promoted_pb_searches":"Trending on Premium Beat","promoted_getty_searches":"Trending on iStock"},"search_music":{"meta":{"title":"Download {{ total }} Free {{ query }} Stock Music | Coverr","description":"Explore our collection of royalty-free {{ query }} music. Perfect for videos and projects, find and download high-quality stock music tracks on Coverr."},"no_results_found":"No results found for"},"shutterstock":{"open_premium_beat":"Open premium beat"},"video_scenes":{"share":"Share Scene","view_all":"View all scenes","load_more":"Load more scenes","grid_title":"Free Stock Video Scenes Footage","videos_grid_title":"More videos in scene"},"ai_model_card":{"audio":"Audio","start":"Start","start_end":"Start / End"},"ai_video_card":{"cta_copy":"Try now"},"category_page":{"explore_related_tags":"Explore related tags"},"checkout_page":{"meta":{"title":"Checkout | Coverr","description":"Checkout"}},"confirm_email":{"title":"Confirm your email","description_param":"We’ve sent a verification link to {{ email }}. Check your inbox and follow the steps to access AI Studio."},"confirm_modal":{"no":"Cancel","yes":"Yes","body":"This action is permanent and can’t be undone.","title":"Are you sure you want to proceed?"},"cookie_banner":{"title":"We use cookies","description":"This website uses cookies to give you the best experience"},"image_details":{"download_options":{"large":"Large","small":"Small","medium":"Medium"},"related_images_param":"Related {{ name }} Stock Images"},"plus_features":{"benefits":{"10":"Exclusive content weekly","01":"Recreate with AI","02":"AI Apps","03":"Unlimited Nano Banana Pro","04":"AI Video creation","05":"AI Image creation","06":"AI Music creation","07":"AI Voiceover & SFX","08":"4K footage & WAV music","09":"Ad-free experience"},"titleHTML":"Unlock everything \u003Cbr /> with \u003Cspan class=\"color-gradient-blue\">Premium Plans\u003C/span>","yearly_off":"Yearly (42% off)","billed_yearly":"per month,\nbilled yearly","billed_monthly":"per month,\nbilled monthly","rates_increase":"* Join today and lock in your price before rates increase in early 2025","titleHTML_with_feature":"Upgrade to access \u003Cspan class=\"color-new-primary-main\">{{ feature }}\u003C/span> and other features:","activate_subscription_copy":"Activate Your Subscription Now"},"post_download":{"body":"Change lighting, weather, or camera angles — all from this same shot.","titleHTML":"\u003Cspan class=\"color-new-primary-main\">Recreate\u003C/span> your downloaded video with AI","social_media":"Share in social media:","try_recreate":"Try Recreate","attribution_without_author":"Video downloaded on \u003Ca href=\"https://coverr.co/\" target=\"_blank\" class=\"acu-link\">Coverr\u003C/a>","attribution_with_author_param":"Video by \u003Ca href=\"https://coverr.co/creators/{{ username }}\" target=\"_blank\" class=\"acu-link\">{{ fullname }}\u003C/a> on \u003Ca href=\"https://coverr.co/\" target=\"_blank\" class=\"acu-link\">Coverr\u003C/a>","attribution_without_author_markdown":"Video downloaded on [Coverr](https://coverr.co)","attribution_with_author_markdown_param":"Video by [{{ username }}](ht