eo speech into time-aligned captions and subtitles","bestFitScenarios":"Clear audio with one or few speakers, rapid turnaround captioning at scale via API, multilingual content requiring reliable time alignment and exportable subtitle files","knownLimitations":"Accuracy can drop with heavy background noise, strong accents, or overlapping speakers; niche jargon and names may require manual review; diarization, punctuation, and casing may not be perfect; real-time latency depends on audio length and throughput.","poorFitScenarios":"Extremely noisy or low-quality recordings, heavy cross-talk meetings, strict verbatim legal/medical transcripts, ultra-low-latency broadcast captions, unsupported languages or frequent code-switching"}},"featurePrices":null,"translations":{"de":{"description":"Auto Untertitel"},"es":{"description":"Subtitulos de autos"},"fr":{"description":"Auto sous-titres"},"it":{"description":"Auto sottotitoli"},"nl":{"description":"Auto ondertitels"},"pt":{"description":"Subtítulos automóveis"}}},"video":null,"presets":[]},{"id":"eTjgu0U1iFbt","createdAt":"2025-11-29T00:19:19.182Z","updatedAt":"2026-01-07T09:15:51.384Z","name":"Topaz video upscaler","title":"Topaz video upscaler","description":"Enhance footage, upscale to 4K, restore detail, and reduce noise and artifacts","icon":"aspectRatioLine","type":"app","videoDetailsFeatured":false,"order":0,"key":"topaz-video-upscaler","promptTemplate":null,"videoId":null,"modelId":"1EgSb7BLVugf","model":{"id":"1EgSb7BLVugf","createdAt":"2025-11-11T15:44:55.253Z","updatedAt":"2026-06-22T15:21:08.947Z","key":"topaz-video-upscaler","slug":"topaz-video-upscaler","name":"Topaz Video Upscaler","logo":"topaz","type":"video","order":52,"toolId":"AE9HKgNOvj","description":"Topaz Video Upscaler","freeGenerations":0,"maxPromptLength":0,"pricePerUnit":500,"minimumUnits":1,"unitLabelSingular":"video","unitLabelPlural":"videos","generationTime":180,"isActive":false,"isNew":true,"isPremium":true,"isFeatured":false,"hasGenerat