 link","description":"Don’t worry! A password reset link will be sent to the email provided.","email_placeholder":"Enter your e-mail"},"verify_email_confirmation":{"title":"Email verification successful!","submit":"Back to Home","description":""},"password_reset_confirmation":{"title":"Password reset successful!","submit":"Back to Login","description":""},"request_email_verification_success":"Email verification request has been sent","request_password_reset_confirmation":{"title":"Password reset link has been sent to your email","submit":"Back to Login","description":"Please check {{email}} for the password reset link."}},"blog":{"hero":{"title":"Blog","description":"Behind the scenes of the creation and utilization of stunning, free videos"},"meta":{"title":"Blog | Coverr","description":"Behind the scenes of the creation and utilization of stunning, free videos."}},"grid":{"title":"Stock Videos","load_more":"Load more","open_video":"Open Coverr video","title_free":"Free Stock Videos","title_more":"More Stock Videos","title_param":"{{ name }} Stock Videos","audios_title":"Free Stock Music","images_title":"Free Stock Images","title_related":"Related Free Stock Videos","title_more_free":"More Free Stock Videos","title_free_param":"Free {{ name }} Stock Videos","title_more_param":"More {{ name }} Stock Videos","audios_title_param":"Free {{ name }} Stock Music","images_title_param":"Free {{ name }} Stock Images","title_more_partners":"More from Our Partners","title_related_param":"Related {{ name }} Stock Videos","title_more_free_param":"More Free {{ name }} Stock Videos","title_related_free_param":"Related Free {{ name }} Stock Videos"},"home":{"faq":{"questions":[{"answer":"Yes! Coverr video is a completely free stock footage website that allows you to download and use high-quality stock videos anywhere. And there is no catch! No sign-up needed, no attribution required or hidden tricks anywhere, when we say free, we mean it.","question":"Are all Coverr videos completely free? What’s the catch?"},{"answer":"Of course you can, please do!","question":"Can Coverr Videos be used for commercial projects?"},{"answer":"Yes, we do! Check out our \u003Ca href=\"/developers\" aria-label=\"Developers page\" class=\"acu-link\">API documentation\u003C/a> for more details.","question":"Do you have an API?"}],"more_title":"Still have questions?","more_button":"See more questions about our free videos"},"meta":{"title":"Free Stock Video Footage, Royalty Free Videos for Download","description":"Download royalty free (for personal and commercial use), unique and beautiful video footage for your website or any project. No attribution required."},"plus":{"billed":{"yearly":"per month, billed yearly","monthly":"per month, billed monthly"},"titleHTML":"Get Exclusive Perks and Boost Your Creativity with \u003Cspan class=\"color-gradient-blue\">Coverr+ Premium Content\u003C/span>","description":"Upgrade to Coverr+ and enjoy members-only content, higher quality files and more..."},"music":{"text":"Never worry about rights and royalty","moods":{"title":"Mood","1_card_title":"Uplifting","2_card_title":"Dreamy","3_card_title":"Peaceful"},"genres":{"title":"Genres","1_card_title":"Hip Hop","2_card_title":"Cinematic","3_card_title":"Electronic"},"titleHTML":"Try \u003Cspan class=\"color-gradient-cyan\">Coverr music\u003C/span>","instruments":{"title":"Instruments","1_card_title":"Synth","2_card_title":"Piano","3_card_title":"Guitar"}},"title":"Beautiful Free Stock Video Footage","videos":{"cta":"Browse Video Library","title":"Explore Coverr’s Stock Video Library","description":"Discover high-quality HD & 4K footage — curated for creators like you","getty_title":"Popular iStock Videos"},"trending":"Trending","subscribe":{"text":"Join the Coverr community and get exclusive videos and special offers every week. Unlock our curated collection by entering your email below.","title":"Exclusive free videos weekly","text_subscribed":"Download our curated collection","