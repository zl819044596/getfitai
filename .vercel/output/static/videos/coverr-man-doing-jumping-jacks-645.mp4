ment":{"cancel":{"title":"Cancel anytime","description":"No hidden stuff or hard feelings"},"secure":{"title":"Secure payment","description":"Transactions are encrypted and secured"},"methods":{"title":"Payment Methods"}},"one_hour":"1 hour","off_param":"{{ save }}% OFF","two_hours":"2 hours","two_minutes":"2 minutes","free_plan_features":["Selected AI video models","Selected AI image models","Free Videos & Music with sponsored ads","HD Video Quality & MP3 Music"],"paid_plan_features":[{"label":"Full AI Studio access","explanation":"Unlock every AI model in the studio — video, image, audio generation, and more."},{"tags":["New"],"label":"Coverr Recreate","explanation":"Transform your videos with AI — change weather, lighting, time of day, angles, and objects."},{"label":"4K Footage & WAV Music"},{"label":"Premium cinematic stock footage"},{"tags":["Veo 3.1","Sora 2"],"label":"All latest models"},{"label":"Google Nano Banana"},{"label":"{{ tasks }} parallel tasks","explanation":"Run up to {{ tasks }} AI generations at the same time."},{"label":"Ad‑Free Experience"},{"label":"Priority generations & support"}],"credits_amount_param":{"label":"{{ credits }} AI credits","voiceovers_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> voiceovers","audios_plural_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> audio tracks","images_plural_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> images","videos_plural_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> short videos","audios_singular_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> audio track","images_singular_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> image","videos_singular_param":"\u003Cspan class=\"color-new-primary-main\">~{{ count }}\u003C/span> short video"},"black_friday_tag_param":"Black Friday Sale up to {{ save }}% off"},"sstk":{"codeHTML":"Code: \u003Cspan class=\"code-accent\">{{code}}\u003C/span>","view_all":"View all","promoHTML":"\u003Cspan class=\"promo-accent\">Limited Time\u003C/span> - {{discount}}% off on Shutterstock Footage","open_video":"Open shutterstock video","title_popular":"Popular Shutterstock Videos","title_related":"Related Shutterstock Videos","title_related_v2":"Related videos","premium_beat_title":"Popular PremiumBeat Music","exclusive_content_HTML":"Get exclusive tracks on \u003Cspan class=\"color-gradient-cyan\">PremiumBeat\u003C/span>"},"about":{"free":{"title":"Yes, we said free","paragraph_1":"There’s no catch here. We grew our business by leveraging our talents as creators, but we know that not everyone has the skills or resources to do so. As filmmakers first, we believe that good video deserves to be paid for, so we pay creators to bring you exceptional videos from around the world.","paragraph_2":"But we share them free to empower entrepreneurs, dreamers, and builders to launch their next project a little easier. So make something really cool with our videos, OK?"},"hero":{"body":"Coverr was born out of our own business needs and grown from our passion as filmmakers.","title":"Videos for everyone"},"meta":{"title":"About Us | Coverr","description":"Coverr was born out of our own business needs and grown from our passion as filmmakers. While our videos are free, we’re paying the filmmakers behind them. | Coverr"},"story":{"title":"We consist of forward-looking videos, created to inspire, energize and support you.","paragraph_1":"Founded in 2015, Coverr offers a catalog of thousands of free, high-quality videos that have been downloaded more than 5 million times and are viewed 1.1 million times each month.","paragraph_2":"Coverr began as a Veed.me side project when we realized that we, along with so many entrepreneurs and startups, needed beautiful videos for the products we build. As filmmakers ourselves, we were already shooting footage in our spare time, so why not give it to the world, absolutely free?","paragraph_3":"As we continued to work on our businesses, Veed.me was acquired by Fiverr, but we continue to growing Coverr as our side project — true to its roots.","paragraph_4":"We’ve always been hyper-obsessed with making quality videos accessible to everyone. We started our journey in 2012 when we founded our video production marketplace, Veed.me. Veed.me was launched with the simple premise of connecting talented filmmakers and film students with great companies looking to create videos — no big, expensive agencies necessary."},"know_more":{"title":"Know more about us","read_article":"Read article","visit_our_medium":"Visit our Medium"}},"getty":{"promo":"Exclusive: -{{discount}}% off with code","open_getty":"Open Getty","promo_copied":"Promotion Code was copied to clipboard!","title_explore":"Explore iStock Videos","cta_remove_ads":"Remove ads","title_trending":"Trending on iStock","title_sponsored":"Sponsored by iStock","affiliate_end_promo":"Need more? Visit our partner and use promocode"},"music":{"freebies":{"title":"While you wait, here are some freebies","genres":{"pop":"Pop","ambient":"Ambient","cinematic":"Cinematic"}},"premium_beat":{"categories":{"pop":"Pop","jazz":"Jazz","cinematic":"Cinematic","corporate":"Corporate","electronic":"Electronic"}}},"terms":{"li_1":{"title":"Acceptance of Terms","section_1":"The following agreement consists of the terms and conditions governing use and access by contributors of videos to the Website (\u003Cstrong>\"Contributor(s)\"\u003C/strong>), and users who download Videos (defined below) from the Website (\u003Cstrong>\"User(s)\"\u003C/strong>; Contributors and Users are collectively defined as \u003Cstrong>\"you\"\u003C/strong> or \u003Cstrong>\"user\"\u003C/strong>). \u003Cstrong>“Website”\u003C/strong> shall mean Veedme Ltd.’s (\u003Cstrong>\"Coverr\"\u003C/strong> or \u003Cstrong>\"We\"\u003C/strong>) website available at: \u003Ca href=\"https://coverr.co/\" target=\"_blank\"> https://coverr.co/ \u003C/a>and the features, services and content therein. These COVERR TERMS OF USE together with the Coverr Privacy Policy available at: \u003Ca href=\"https://coverr.co/privacy/\" target=\"_blank\">https://coverr.co/privacy\u003C/a> (the \u003Cstrong>\"Terms\"\u003C/strong>) constitute a binding agreement between you and Coverr, and by continuing to use the Website (in whole or in part) in any way or manner you agree to abide by, and be bound, by these Terms. If you do not understand and/or agree to these Terms, you should immediately exit the Website and cease making any use thereof.","section_2":"We may unilaterally change or add to the terms of these Terms at any time. In the event of a material change, We shall notify you via email or by means of a prominent notice on the Website. You should check our Website periodically and review changes to the Terms at the following URL: \u003Ca href=\"https://coverr.co/terms/\" target=\"_blank\">https://coverr.co/terms/\u003C/a>. By continuing to use the Website following such modifications, you agree to be bound by such modifications. If you are not comfortable with all of the provisions of these Terms, please do not use the Website."},"li_2":{"title":"License","section_1":"Subject to the terms and conditions set forth herein, Coverr hereby grants to you, and you accept, a personal, nonexclusive, non-transferable, non-assignable, non-sublicensable, revocable, limited license to access and make  non-commercial use of the Website. The third party video content, moving images, animations, films, or other audio/visual representations provided on the Website (\u003Cstrong>“Videos”\u003C/strong>), are licensed directly by the authors of the Videos in accordance with the terms of the license set forth at \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\">https://coverr.co/license\u003C/a>."},"li_3":{"title":"Limitations on Use ","section_1":"Except as specifically permitted herein, you agree n