04:832","832:1104","1584:672"],"resolutions":[],"overrideEnhancePrompt":"","imageInputValidation":{"maxSize":10,"minWidth":0,"minHeight":0,"maxWidth":0,"maxHeight":0,"minAspectRatio":0.5,"maxAspectRatio":2},"videoInputValidation":{"maxSize":200,"minWidth":0,"minHeight":0,"maxWidth":0,"maxHeight":0,"minDuration":0,"maxDuration":0,"allowedExtensions":[]},"customOptions":null},"modes":[],"features":{"list":["edit-video"],"content":{"modelType":"In-context generative video editing and creation model","topUseCases":"Reframing and new camera angles for existing footage, Object insertion/removal and continuity fixes, Environment swaps and world-building, Style exploration and look development, Previz and concepting for ads, films, and social content","keyStrengths":"Cutting-edge realism, Precise scene-level control (angles/objects/environments), Versatile style application","primaryPurpose":"Edit and create videos by generating new camera angles, adding/removing objects, changing environments, and applying unique styles with high realism","bestFitScenarios":"Short-to-mid length shots with clear visual context, Rapid creative iteration on style and composition, Targeted edits to scenes (reframes, object edits, environment changes) where realism is paramount","knownLimitations":"May show temporal drift on long clips, Complex physics or fine text/graphics can be inconsistent, Identity or brand-perfect preservation may require manual supervision, Requires clear prompts and quality source context, Compute-intensive for high resolutions","poorFitScenarios":"Long-form sequences needing strict continuity across many minutes, Frame-perfect technical VFX (precise matchmoving/roto) or scientific accuracy, Scenes with heavy occlusion or chaotic motion, Tasks demanding guaranteed brand/logo or identity fidelity without manual QC"}},"featurePrices":null,"translations":{"de":{"description":"Runway Aleph ist ein AI-Video-Modell der nächsten Generation für die Kontext-Videobearbeitung und -Erstellung.Erzeugen Sie neue Kamerawinkel, fügen Sie Objekte hinzu oder entfernen Sie sie, ändern Sie Umgebungen und wenden Sie einzigartige Stile mit modernem Realismus an."},"es":{"description":"Runway Aleph es un modelo de vídeo de próxima generación de IA para la edición y creación de vídeo en contexto. genera nuevos ángulos de la cámara, agrega o elimina objetos, cambia entornos y aplica estilos únicos con un realismo de vanguardia."},"fr":{"description":"Runway Aleph est un modèle vidéo d'IA de nouvelle génération pour l'édition et la création de vidéos contextuelles. Générer de nouveaux angles de caméra, ajouter ou supprimer des objets, modifier les environnements et appliquer des styles uniques avec un réalisme de pointe."},"it":{"description":"Runway Aleph è un modello video AI di prossima generazione per l'editing e la creazione di video in contesto. Generare nuovi angoli della fotocamera, aggiungere o rimuovere oggetti, cambiare ambienti e applicare stili unici con realismo all'avanguardia."},"nl":{"description":"Runway Aleph is een AI-videomodel van de volgende generatie voor het bewerken en maken van contextuele video's. Geef nieuwe camera-hoeken, voeg objecten toe of verwijder objecten, verander omgevingen en breng unieke stijlen toe met geavanceerde realisme."},"pt":{"description":"O Runway Aleph é um modelo de vídeo AI de próxima geração para edição e criação de vídeo em contexto, gerando novos ângulos da câmera, adicionando ou removendo objetos, mudando ambientes e aplicando estilos únicos com realismo de ponta."}}},"video":{"id":"jGmcsGkoSZ","createdAt":"2025-10-27T23:50:36.155Z","updatedAt":"2025-10-27T23:50:36.155Z","title":"Calm Hospital Room at Night","description":"A peaceful view of an empty hospital room illuminated by soft lighting, featuring a hospital bed and medical equipment monitoring vital signs, creating a serene atmosphere.","baseFilename":"user-ai-generation-VlzTMEbjgVkr","publishedAt":"2025-10-27T23:50:36.155Z","searchKeywords":n