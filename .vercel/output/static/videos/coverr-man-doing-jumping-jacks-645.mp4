</style><style ng-app-id="ng">.acu-divider{width:100%;height:1px;flex-shrink:0;background:var(--divider, rgba(250, 250, 255, .08))}.acu-hide-scroll{-ms-overflow-style:none;scrollbar-width:none}.acu-hide-scroll::-webkit-scrollbar{display:none}.acu-purple-gradient-blur{z-index:0;position:relative}.acu-purple-gradient-blur:before{content:"";position:absolute;inset:6px;z-index:-1;filter:blur(12px);background:var(--gradient-purple, linear-gradient(87deg, #FF47DA 0%, #5A5AE0 100%))}.acu-glassmorphism{-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);border:.5px solid rgba(255,255,255,.6);background-color:#0000000d;box-shadow:#ffda2a1a -1.996px 2.391px 18.109px -2.622px inset,#fff6 -5.73px -4px 3.36px -2.73px inset,#ffffff4d 6.671px 6.671px 3.363px -6.214px inset,#ffffff80 0 1px 12.2px -5px inset,#fff6 -6.727px -6.727px 3.363px -6.727px inset,#ffffff4d 6.671px 6.671px 3.363px -6.214px inset}.acu-avatar{transition:border-color .15s ease-in-out,background-color .15s ease-in-out;--acu-avatar-size: 28px;--acu-avatar-border-width: 1px;--acu-avatar-background-color: var(--secondary-main);--acu-avatar-hover-border-color: var(--secondary-hover);--acu-avatar-hover-background-color: var(--secondary-hover);--acu-avatar-label-font-size: 10px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: .2px;--acu-avatar-icon-size: 16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;width:var(--acu-avatar-size);height:var(--acu-avatar-size);border-radius:var(--rounded-full, 9999px);background-color:var(--acu-avatar-background-color)}.acu-avatar__img{object-fit:cover;width:100%;height:100%;border-radius:var(--rounded-full, 9999px)}.acu-avatar__label{text-align:center;font-style:normal;line-height:normal;font-size:var(--acu-avatar-label-font-size);font-weight:var(--acu-avatar-label-font-weight);letter-spacing:var(--acu-avatar-label-letter-spacing);color:var(--new-primary-contrast)}.acu-avatar__icon{width:var(--acu-avatar-icon-size);height:var(--acu-avatar-icon-size)}.acu-avatar-xs{--acu-avatar-size: 28px;--acu-avatar-label-font-size: 10px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: .2px;--acu-avatar-icon-size: 14px}.acu-avatar-sm{--acu-avatar-size: 36px;--acu-avatar-label-font-size: 14px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: 0px;--acu-avatar-icon-size: 16px}.acu-avatar-md{--acu-avatar-size: 44px;--acu-avatar-label-font-size: 14px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: 0px;--acu-avatar-icon-size: 20px}.acu-avatar-lg{--acu-avatar-size: 56px;--acu-avatar-label-font-size: 20px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: -.4px;--acu-avatar-icon-size: 24px}.acu-avatar-xl{--acu-avatar-size: 64px;--acu-avatar-label-font-size: 20px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: -.4px;--acu-avatar-icon-size: 28px}.acu-avatar-2xl{--acu-avatar-size: 96px;--acu-avatar-label-font-size: 20px;--acu-avatar-label-font-weight: 600;--acu-avatar-label-letter-spacing: -.4px;--acu-avatar-icon-size: 28px}.acu-avatar-indenticon{--acu-avatar-background-color: var(--new-primary-main);--acu-avatar-hover-background-color: var(--new-primary-hover)}.acu-avatar-gradient-blue{z-index:0;position:relative}.acu-avatar-gradient-blue:before{content:"";position:absolute;z-index:-1;inset:0;padding:var(--acu-avatar-border-width);border-radius:var(--rounded-full);background:var(--gradient-blue);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude}.acu-avatar-gradient-blue{padding:var(--acu-avatar-border-width)}.acu-avatar-gradient-pink{z-index:0;position:relative}.acu-avatar-gradient-pink:before{content:"";position:absolute;z-index:-1;inset:0;padding:var(--acu-avatar-border-width);border-radius:var(--rounded-full);background:var(--gradient-pink);-webkit