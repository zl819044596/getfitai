nning results with PromptLab.","submit_button":"Submit a workflow and get featured"},"workflows_page":{"hero":{"meet_creators":"Meet the Creators","submit_prompt":"Submit a workflow and get featured","most_popular_tools":"Most Popular Tools","most_popular_video_models":"Most Popular Video AI Models"},"footer":{"title":"Want to create amazing AI videos, but feel lost in the process?","subtitle":"Prompt Lab is your key. Explore breathtaking AI footage and learn the step-by-step workflows from AI experts who created them. Unleash your creative vision and join the waitlist to be the first to know!"}},"categories_page":{"meta":{"title":"Categories | Coverr","description":"Explore Categories on Coverr"},"title":"Stock Video Footage","subtitle":"Choose a category to explore"},"suggest_feature":{"title":"Suggest a feature","toast":{"error":"Error sending feature suggestion","success":"Thank you for your idea!"},"message":{"errors":{"required":"Please fill out this field"},"placeholder":"Write your idea here..."},"description":"Thanks for helping us improve!"},"support_ukraine":{"title":"Support Ukraine and free creation","learn_more":"Learn more"},"ai_studio_widget":{"end_image":"End image","reference":"Reference","start_image":"Start image","prompt_limit":"You've reached the character limit for your prompt ({{ promptLength }}/{{ maxPromptLength }})","reference_image":"Reference image"},"api_integrations":{"id":"ID","demo":"Demo","meta":{"title":"API Applications | Coverr","description":"API Applications"},"errors":{"error_create":"Ooops, error happened while creating an application. Please try again.","error_delete":"Ooops, error happened while deleting an application. Please try again.","error_update":"Ooops, error happened while updating an application. Please try again.","error_verify":"Ooops, error happened while requesting application verification. Please try again.","error_publish":"Ooops, error happened while publishing an application. Please try again.","name_required":"Name field is required","field_required":"Field is required","description_required":"Description field is required","error_create_limit_title":"Application limit reached","error_publish_limit_title":"You have reached the maximum number of published applications","error_create_limit_description":"You can create a maximum of {{count}} apps.","error_publish_limit_description":"If you want to have more than 1 application, please contact us at \u003Ca href=\"mailto:team@coverr.co\" class=\"acu-link\">team@coverr.co\u003C/a>."},"status":"Status","api_key":"API Key","app_name":"App name","in_review":"In Review","delete_yes":"Yes, I would like to delete.","enterprise":"Enterprise","name_title":"What’s the name of your app?","production":"Production","delete_body":"The deletion is permanent. Once an application is deleted, it cannot be recovered.","applications":"Applications","delete_title":"Are you sure you want to delete the application?","status_details":"Status details","name_placeholder":"Name","description_title":"Please provide a description of your app","update_application":"Update application","pending_status_info":"Your app is under review.","verified_status_info":"Production status gives you \u003Cstrong>2,000 requests per hour.\u003C/strong>","do_you_have_questions":"Do you have any question? Check out our \u003Ca href=\"https://api.coverr.co/docs\" aria-label=\"Documentation\" class=\"acu-link\" target=\"_blank\">Documentation\u003C/a> or \u003Ca href=\"mailto:team@coverr.co\" target=\"_blank\" class=\"acu-link\">Contact Us\u003C/a>.","create_new_application":"Create new application","enterprise_status_info":"Need more requests? Contact us at \u003Ca href=\"mailto:team@coverr.co\" target=\"_blank\" class=\"acu-link\">team@coverr.co\u003C/a>.","no_applications_header":"Thanks for your interest in using our API!","unverified_status_info":"Demo status gives you \u003Cstrong>50 requests per hour.\u003C/strong>","verification_questions":{"will_you_pay":"Are you open to paying for using our API?","whats_your_role":"What’s your role?","whats_your_site":"Please provide the URL of your site","how_much_will_pay":"How much are you willing to pay for using our API?","will_you_pay_options":["Yes","No"],"how_soon_to_implement":"How soon are you planning to implement the API?","whats_your_company_name":"What’s the name of your company?","will_you_pay_yes_answer":"Yes","how_much_will_pay_options":["$10 - $50 per month","$50-$200  per month","$200 - $500 per month","I’m flexible"],"how_soon_to_implement_options":["ASAP","1-3 months","4-6 months","6+ months"]},"description_placeholder":"Description","request_app_verification":"Request app verification","no_applications_description":"Create an application to start using our API."},"collections_page":{"meta":{"title":"Collections | Coverr","description":"Explore curated collections handpicked by our staff"},"title":"Collections","one_item":"item","description":"Explore curated collections handpicked by our staff","plural_of_items":"items"},"contribute_modal":{"title":"Contribute to Coverr","toasts":{"video_submitted":{"title":"Video Submitted! Thank You!","description":"We’ll review your video and publish it on our website."}},"license":"All published videos are licensed under the \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\" class=\"acu-link\">Coverr license\u003C/a> and are free to use. Videos will appear in both the video library and AI workflows.","subtitle":"Thank you for helping us make content accessible to everyone!","features_list":{"title":"What you’ll get:","features":["Become a verified contributor","Receive the attention of our audience","Credit as the author of your content","Personalized author page on our platform"]}},"download_history":{"meta":{"title":"Download History | Coverr","description":"Download History"}},"free_stock_music":{"faq":[{"answer":"\u003Cp>Royalty-free music is a type of music licensing that allows individuals and businesses to use music without having to pay ongoing royalties or fees for each use.\u003C/p>\u003Cp class=\"mt-3\">Coverr offer you to download free stock music with no tricks and extra fees.\u003C/p>","question":"What is royalty-free music?"},{"answer":"We’re now in the hunt for the best composers out there, we’re paying for all the free music we’re going to offer so if you’re interested, please apply \u003Ca href=\"/developers\" aria-label=\"Developers page\" class=\"acu-link\">here\u003C/a>.","question":"I’m a musician/composer, how can I get involved?"},{"answer":"Since WAV format is the highest quality, and quality is what we believe in, you’ll get our free songs in: WAV 16 bit, 44.1 kHz MP3 320 kbit/s","question":"What is the quality of the songs available to download?"},{"answer":"\u003Cp>Coverr Free Music is ideal to be used as free background music for all types of videos. Other popular use cases where you can use our free music tracks include:\u003C/p>\u003Cul>\u003Cli>YouTube\u003C/li>\u003Cli>Blogs\u003C/li>\u003Cli>Music Videos\u003C/li>\u003Cli>Websites\u003C/li>\u003Cli>Social Media platforms\u003C/li>\u003Cli>Podcasts\u003C/li>\u003Cli>Online ads\u003C/li>\u003Cli>Video Games\u003C/li>\u003C/ul>","question":"Where can I use Coverr’s Free Stock Music?"},{"answer":"Yes, it’s fine to use our stock music tracks and videos on YouTube.","question":"Can I use Coverr Free Music on YouTube?"},{"answer":"That’s because we have an affiliate partnership in which we show our users additional options in case we weren’t able to satisfy our users’ needs.","question":"Why am I seeing music tracks from ShutterStock/PremiumBeat?"},{"answer":"Attribution is appreciated but not required. We’d love to see what you create using our free music and videos, so feel free to mention @coverrco and/or link to coverr.co if you feel like it.","question":"Am I supposed to attribute Coverr if I’m using your free stock music?"},{"answer":"Wow, we love great ideas! Please \u003Ca href=\"/contact-us\" class=\"acu-link\">contact us\u003C/a>.","question":"What if I have a great idea for you guys?"}],"mood":"Mood","genres":"Genres","breadcrumb":"Free Stock Music","top_tracks":"Top tracks","instruments":"Instruments","popular_tags":{"synth":"synth","dreamy":"dreamy","ambient":"ambient","cinematic":"cinematic","electronic":"electronic"}},"get_more_credits":{"title":"Get more AI credits","toast":{"title":"Need more?","description":"Contact us to get more credits"},"description":"Buy more credits and explore your creativity","pricing_toast":{"cta":"View pricing","title":"How much can I generate?","description":"Check detailed plans and costs on our Pricing page"},"pricing_details":{"li_1":"Ai Voice Over - 1 character = 1 credit (1 minute script = ~625 credits)","li_2":"Ai Video - 1 video = 5K credits","li_3":"Ai Sound Effect - 1 sound effect = 200 credits","title":"Pricing details"}},"highlight_banner":{"text":"\u003Cp class=\"highlight-banner__text text-xl\">The \u003Cspan class=\"highlight-banner__gradient-text\">most advanced\u003C/span> AI Video model is now on \u003Cspan class=\"highlight-banner__gradient-text\">Coverr+\u003C/span>\u003C/p>","button_text":"Generate videos with Veo 2","default_alt":"Thumbnail of an AI-generated video created using Google Veo 2"},"plus_hero_widget":{"cta":"Upgrade","title":"Unlock More with Coverr","benefit_1":"AI video creation","benefit_2":"Members-only premium content","benefit_3":"4K Footage & WAV Music","benefit_4":"Ad-free experience","benefit_5":"Support our Filmmakers","benefit_6":"AI Smart Crop","cta_for_plus":"Explore Catalog","title_for_plus":"Coverr+ Unlocked"},"user_collections":{"back":"Back","meta":{"title":"My Collections | Coverr","description":"My Collections"},"name":"Name","title":"Title","errors":{"error_load":"Ooops, error happened while loading a collection. Please try again.","error_create":"Ooops, error happened while creating a collection. Please try again.","error_delete":"Ooops, error happened while deleting a collection. Please try again.","error_update":"Ooops, error happened updating creating a collection. Please try again.","name_required":"Name field is required","title_required":"Title field is required","description_required":"Description field is required"},"add_video":"Add video","delete_yes":"Yes, I would like to delete.","delete_body":"The deletion is permanent. Once a collection is deleted, it cannot be recovered.","description":"Description","delete_title":"Are you sure you want to delete the collection?","start_adding":"Add videos to the collection","new_collection":"New collection","no_collections":"No collections yet","start_exploring":"Start exploring","update_collection":"Update collection","create_new_collection":"Create new collection"},"value_prop_modal":{"title":"Make it yours \u003Cspan class=\"color-new-primary-main\">with AI\u003C/span>","footer":"Ready for more? Check details on","description":"Thanks for downloading — that clip’s yours. Sign up free to save the next one, and the next thousand.","primary_cta_copy":"Sign up free","propositions_section_label":"What you’ll get with a free account:"},"ai_models_section":{"cta":"Try now","title":"Turn your ideas into beautiful AI creations today","description":"Craft new AI visuals or rework any asset from our full stock library — limitless creative possibilities"},"ai_voices_filters":{"age":"Age","accent":"Accent","gender":"Gender","use_case":"Use case"},"cancellation_flow":{"form":{"title":"We are sorry to see you go.","buttons":{"stay":"Stay with Coverr+","cancel":"Cancel Subscription"},"reasons":["I only needed one video","Not enough premium videos available","AI generator quality isn’t good enough","I found a better alternative","I’m not using the service enough","The subscription is too expensive"],"request":"Can you share more about your reason? \u003Cspan class=\"wa-cancel-modal-last__secondary\">(optional)\u003C/span>","description":"Could you please tell us what led you to cancel your subscription?","cancel_reason":"Please, select a reason for canceling"},"hint":"\u003Csup>*\u003C/sup> Your subscription and AI credits stay active until the end of the billing period. You can still access your old AI generated content","title":"Cancel \u003Cspan class=\"color-gradient-blue\">Coverr+\u003C/span> \u003Cbr /> subscription?","values":[{"link":"/studio","text_1":"Full ","text_2":"access and monthly AI credits","ga_event":"cancellation_flow_retention_ai_studio_link","link_label":"AI studio "},{"link":"/stock-video-footage","link_2":"/free-stock-music","text_2":"&","text_3":"for comercial projects","ga_event":"cancellation_flow_retention_4K_footage_link","ga_event_2":"cancellation_flow_retention_wav_music_link","link_label":"4K footage","link_label_2":"WAV music"},{"link":"/stock-video-footage/plus","text_2":"added weekly","ga_event":"cancellation_flow_retention_exclusive_content_link","link_label":"Exclusive content"},{"link":"/profile/edit","text_2":"experience","ga_event":"cancellation_flow_retention_ad_free_link","link_label":"Ad-free"}],"buttons":{"stay":"Stay with Coverr+","cancel":"Cancel Subscription"},"discount":{"title":"One last thing","accept_button":"I’ll take it","cancel_button":"Cancel Subscription","error_message":"There was an error activating your discount. Please try again.","success_message":"Thanks for staying — your subscription will include your discount starting with the next billing period.","description_year":"How about 20% off your yearly renewal as a thank-you for staying with us?","description_month":"How about 50% off your subscription for the next 3 months?"},"feedback":{"text":"Coverr+ is the ultimate creative hub —premium-quality videos, images, and music, combined with powerful AI tools to generate fresh content.","author":"Anna Patel, Social Media Manager"},"description":"You’re about to lose access to your premium AI and creative benefits:"},"contribute_banner":{"title":"Contribute and get discovered","subtitle":"Are you an AI video enthusiast? We would love to feature your work.","benefit_1":"Get more followers","benefit_2":"Inspire others and get inspired","benefit_3":"Join our exclusive community"},"exit_intent_modal":{"title":"Here’s how Coverr stays free","eyebrow":"Before you go","description":"Coverr’s free library is supported by our partner iStock and by our Plus subscribers. Pick whichever suits you — no pressure.","dismiss_copy":"Keep browsing","plus_cta_copy":"Go Plus — ad-free, 4K, full library","istock_promo_cta_copy":"Use iStock with -{{discount}} (code \"{{code}}\")","istock_library_cta_copy":"Browse iStock’s full library"},"help_and_feedback":{"email":{"errors":{"regex":"Please enter a valid email address","required":"Email is required"},"placeholder":"example@example.com"},"toast":{"error":"There was an error sending feedback.","success":"Your feedback has been sent successfully!"},"message":{"errors":{"required":"Message is required"},"placeholder":"Add feedback here..."}},"projects_selector":{"title":"Select a project","delete_modal":{"body":"All creations in this project will be permanently deleted.","title":"Delete this project?","confirm_copy":"Delete project"},"search_placeholder":"Search projects","default_project_name":"Default project","new_project_cta_copy":"New project","create_project_success":"Project created successfully","project_name_placeholder":"Project name"},"subscription_page":{"faq":[{"answer":"Coverr Plus is our premium subscription plan offering members exclusive access to high-quality stock footage, ad-free browsing, 4K video resolution, high-quality WAV format music, and other exciting features and enhancements.","question":"What is Coverr Plus?"},{"answer":"Our team curates and adds fresh, exclusive content to Coverr Plus every week, providing members with a constantly growing library of captivating footage and music tracks for their projects.","question":"How often does Coverr Plus add new content?"},{"answer":"With a Coverr Plus subscription, you can enjoy browsing our platform without any ads or sponsored content, allowing you to concentrate on selecting the perfect footage and music for your creative projects. If you prefer to leave these sponsored content recommendations, you can turn it on.","question":"What does the ad-free experience entail?"},{"answer":"No, access to 4K video resolution and high-quality WAV format music is exclusively available to our Coverr Plus members.","question":"Is 4K footage and WAV music available for free users?"},{"answer":"Simply click on \"Get Coverr+\" or \"See Pricing\" to view our subscription plans, choose the one that best suits your needs, and follow the steps to upgrade your account.","question":"How do I upgrade to Coverr Plus?"},{"answer":"Yes, you can cancel your subscription at any time. Once canceled, your subscription will remain active until the end of your current billing cycle.","question":"Can I cancel my Coverr Plus subscription anytime?"},{"answer":"Coverr Plus content can be used for both personal and commercial projects. For more information on usage rights and restrictions, please refer to our terms of service and licensing agreements.","question":"What are the usage rights and restrictions for Coverr Plus content?"},{"answer":"No, Coverr Plus subscriptions are for single-user licenses only. Only the account owner has the right to use the content. A company can have an account, but it remains a single seat-license, meaning only one person can download and select content/use the content at a time, and it cannot be stored on a DAM for broad sharing rights.","question":"Can I share my Coverr Plus subscription with someone else?"},{"answer":"Yes, your Coverr Plus subscription will automatically renew at the end of each billing period. This ensures uninterrupted access to the features and content provided by Coverr Plus. However, you have the flexibility to cancel your subscription at any time before the renewal date.","question":"Does my subscription automatically renew?"},{"answer":"We offer various payment methods to make it convenient for you to subscribe to Coverr Plus. Currently, we accept major credit cards and PayPal.","question":"What payment methods do you offer?"}],"meta":{"title":"Buy 4K Videos for Commercial Use: Pay for Ultra HD Video","description":"Buy 4K & Ultra HD Videos and WAV Music for Commercial Use ✅ Unlock premium stock footage, ad-free browsing, and high-quality formats."}},"user_upload_modal":{"select":{"or":"or","title":"Upload new Video","size_hint":"Minimum 640px width recommended. Max 80 MB each.","select_file":"Select File","create_scene":"Create Scene","drag_drop_hint":"You can Drag & Drop files and folders onto this page","guideline_format":"High resolution Videos (.MP4, .MOV)","guideline_rights":"Only upload media you own the rights to"},"upload":{"title":"Upload new Video","toast":{"error":{"title":"An error occurred while uploading files","description":"Here are the files that have not been uploaded"},"success":{"title":"Uploading Successfully Started","description":"Please wait until the upload is complete and don’t close this window"}},"add_scene":"Add Scene","add_videos":"Add videos","select_file":"Select file","remove_scene":"Remove Scene","videos_title":"Videos","save_and_upload":"Save & Upload","license_agreement":"By uploading videos you agree that these videos will fully belong to Coverr"},"success":{"close":"Close Modal","title":"All videos have been successfully uploaded!","upload_more":"Upload More"}},"ai_gen_card_shared":{"error":{"refund_HTML":"Credits for this failed generation will be refunded automatically within minutes. You can view it in your \u003Ca href=\"{{creditHistoryUrl}}\" class=\"acu-link\">AI Credit History\u003C/a>"},"loader":{"refund":"Credits will be refunded if the generation fails"}},"ai_video_workflows":{"toasts":{"prompt_copied":"Prompt was copied to clipboard!"},"tools_used":"TOOLS USED:","ai_workflow":"AI Workflow:","prompt_label":"Prompt:","view_workflow":"View AI Workflow","description_label":"Description:"},"image_upload_modal":{"content":{"hint":"Supported formats: JPG, PNG, WEBP, AVIF","title":"Select images to upload"},"title_review":"Review Images","title_upload":"Upload Images","select_images":"Select Images","failed_to_upload_param":"Failed to upload {{fileName}}. Please try again."},"select_image_modal":{"mode":{"upload":"Upload","my_uploads":"My Uploads","my_generations":"My Generations"},"title":"Select Image","upload":{"title":"Upload or drag and drop","description":"JPG or PNG up to 10MB","select_file":"Select File"},"no_uploads":{"title":"No uploads yet","description":"Your uploaded images will appear here"},"no_generations":{"title":"No generations yet","description":"Your AI-generated images will appear here"}},"select_video_modal":{"mode":{"upload":"Upload","use_stock":"Use Stock","my_uploads":"My Uploads","my_generations":"My Generations","original_stock":"Original Stock"},"title":"Select Video","errors":{"video_too_long":{"title":"Video is too long","description_param":"Video duration should be less than {{ maxVideoDuration }} seconds"}},"upload":{"title":"Upload Video","accept":"Accept","replace":"Replace","processing":"Processing...","description":"Drag and drop or click to upload","select_file":"Select File"},"no_results":{"title":"No results found","description":"Try a different query"},"no_uploads":{"title":"No uploads yet","description":"Your uploaded videos will appear here"},"no_generations":{"title":"No generations yet","description":"Your AI-generated videos will appear here"},"search_placeholder":"Search for a video..."},"subscription_modal":{"cta":{"upgrade":"Upgrade","view_pricing":"View more pricing plans"},"toggle":{"billed_yearly":"billed yearly","billed_monthly":"billed monthly"},"features":{"stock_4k":"4K Video Downloads","stock_wav":"WAV Audio Downloads","api_publish":"Production API","apps_recreate":"Recreate with AI","stock_premium":"Premium Content","generators_sfx":"AI Sound Effects","generators_image":"AI Image Generation","generators_music":"AI Music Generation","generators_video":"AI Video Generation","apps_auto_subtitles":"Auto Subtitles","generators_voiceover":"AI Voiceover","apps_topaz_image_upscaler":"Image Upscaler","apps_topaz_video_upscaler":"Video Upscaler"},"feedback":{"text":"Coverr+ offers the most curated, high-quality stock footage I’ve found, and with music and AI tools, it’s the complete creative solution.","author":"Anna Patel, Social Media Manager"},"titleHTML":"Unlock more with \u003Cspan class=\"color-new-primary-main\">Coverr Plus\u003C/span>","description":{"default":"Upgrade to Coverr Plus and enjoy members-only content, higher quality files and more...","remove_ads":"Upgrade to unlock ad-free experience","ai_features":"Upgrade to unlock AI features","api_publish":"Upgrade to publish your API app","download_4k":"Upgrade to download premium stock in 4K"},"recommended":"Recommended","discount_badge":"Save {{value}}%"},"collections_section":{"more_collections":"More collections","explore_collections":"Explore video collections"},"password_reset_page":{"meta":{"title":"Password reset | Coverr","description":"Reset your password"}},"post_download_music":{"title":"Attribution required","pb_title":"Explore more music on PremiumBeat","subtitle":"Copy the text below to attribute.","get_notified":"Get notified","subscribe_title":"Subscribe to get updates about Coverr Music","download_started":"Download started!","attribution_text_HTML":"Audio downloaded on \u003Ca href=\"https://coverr.co/\" target=\"_blank\" class=\"acu-link\">Coverr\u003C/a>","attribution_text_markdown":"Audio downloaded on [Coverr](https://coverr.co)"},"premium_video_block":{"title":"Unlock this premium video and also get:","features":["AI video generator","AI voiceover generator","4K footage & WAV music","Exclusive content added weekly","Ad-free experience"]},"user_ai_generations":{"meta":{"title":"AI Video Generations | Coverr","description":"Your Video Generations"},"title":"Create stunning videos","toast":{"title":"Workflows are being reviewed","description":"We are reviewing your workflows, once they are approved you will be able to upload more."},"header":"Your Video Generations","description":"Join the future of video creation. Unlock the potential of AI-powered prompts, seamless workflows, and stunning results with PromptLab.","submit_button":"Generate New AI Video"},"get_more_free_videos":{"title":"Get more videos","email_us":"Email Us for More Videos","description":"This video limit is temporary for the beta version. Want more videos? Just email us at","request_more":"Request More Videos","share_feedback":"Share Feedback with Our Team"},"notifications_widget":{"ideas_title":"Coverr Ideas","newsfeed_title":"What’s new on Coverr","suggest_feature":"Suggest feature","success_vote_toast":"You’ve successfully voted for this idea!","success_unvote_toast":"You’ve successfully removed your vote.","signup_vote_description":"Sign up to vote for ideas","signup_suggest_description":"Sign up to suggest your own idea"},"workflow_upload_modal":{"form":{"title":"Describe your workflow"},"title":"Upload videos you generated with AI","select":{"title":"Upload your AI-generated video","guidelines":{"guideline_0":{"title":"Workflow Sharing","description":"Don’t upload if you’re not planning to share the workflow behind the creation; it won’t be published."},"guideline_1":{"title":"Original Content","description":"Upload only videos you have created. No stolen or copied content."},"guideline_2":{"title":"Quality","description":"Ensure videos are high resolution (1080p or higher) and visually appealing."},"guideline_3":{"title":"No Spam","description":"Avoid clickbait and do not upload repetitive or misleading content."},"guideline_4":{"title":"AI-Generated Only","description":"Upload only AI-generated content."},"guideline_5":{"title":"License Agreement","description":"By uploading a video, you acknowledge it will have the"}},"description":"After your video is uploaded, you’ll be able to add your workflow’s steps","select_file":"Select File"},"upload":{"grid":{"title":"Videos","add_video":"Add video"},"toast":{"error":{"title":"An error occurred while uploading files","description":"Here are the files that have not been uploaded"},"success":{"title":"Uploading Successfully Started","description":"Please wait until the upload is complete and don’t close this window"},"limit_error":{"title":"Submissions are limited","description":"Your account is not yet verified to submit workflows. You can upload up to 3 workflows for the review."}},"user_consent":"You acknowledge that your videos will be publicly available to our users under these terms","submit_prompt":"Start upload"},"confirm":"Are you sure? Progress won’t be save.","success":{"title":"Successfully uploaded!","description":"Workflow have successfully uploaded!","upload_more":"Upload more workflows","view_workflows":"View my workflows"}},"ai_video_workflow_page":{"title":"AI Workflow"},"ai_generated_audio_card":{"error_title":"Audio couldn’t be created","creation_title":"Your audio is being generated","error_subtitle":"Something went wrong","creation_subtitle":"This usually takes up to a minute"},"current_promotion_modal":{"timer_days":"days","timer_hours":"hours","timer_minutes":"minutes","timer_seconds":"seconds"},"email_verification_gate":{"title":"Please verify your email","subtitle":"We sent a verification link to","resend_cta":"Resend verification email","subtitle_2":"Click the link in the email to verify your account.","spam_notice":"Don’t see it? Check your spam — it might be hiding there.","already_sent_cta":"Already sent","resend_countdown":"You can resend again in {{ seconds }}s","verified_success":"Email verified! You can now use all features.","already_verified_cta":"I’ve already verified","not_verified_yet_title":"Your email hasn’t been verified yet","not_verified_yet_description":"Check your inbox and spam folder."},"ai_generated_image_modal":{"inline_actions":{"title":"Recreate with AI","description":"Create new content from this image with AI","create_video":"Create video","edit_description":"Edit with Nano Banana Pro"}},"ai_generated_video_modal":{"inline_actions":{"title":"Recreate with AI","description":"Create new content from this video with AI"}},"ai_video_generation_card":{"error":{"title":"Video Couldn’t Be Created."},"loader":{"title":"Your video is being generated.","description":"This usually takes about a minute."},"toasts":{"moved_to_project":{"description":"Generation moved to {{projectName}}"}},"tooltips":{"video_processing":"Your video is currently being processed. Once complete, you will be able to publish it."},"more_options":"More options"},"ai_video_generation_page":{"idea":"Idea","tabs":{"text_to_video":"Text to Video","image_to_video":"Image to Video"},"empty":{"title":"Generate your first video","description":"Your AI-generated videos will appear here once they’re ready"},"title":"Generate AI Videos","errors":{"prompt_long":{"title":"Prompt is too long","description_param":"Your prompt is too long. Please keep it under {{ count }} characters."},"prompt_short":{"title":"Prompt is too short","description_param":"Your prompt is too short. It must be at least {{ count }} characters long."},"image_required":{"title":"Image is required","description":"An image is required for this model. Please upload at least one image."},"video_required":{"title":"Video is required","description":"A video is required for this model. Please select a video."},"prompt_required":{"title":"Prompt is required","description":"Please enter a prompt to generate your video."},"end_image_required":{"title":"End image is required","description":"An end image is required for this model. Please upload an image."},"start_image_required":{"title":"Start image is required","description":"A start image is required for this model. Please upload an image."}},"get_more":"Get more","tooltips":{"no_generations":"Your generation limit for this month has been reached based on your subscription purchase date. Consider buying extra credits or waiting for the next batch to be available.","plan_generations":"You currently have {{ planRemaining }} video generations left out of {{ planTotal }} available on your current plan per month","extra_generations":" + {{ count }} extra generations you have baught. You can always buy more."},"description":"Use the Image to Video or Text to Video AI generator","delete_modal":{"body":"This video will be deleted forever. You can’t restore it back.","title":"Delete Video?","confirm_text":"Delete video"},"minutes_param":"{{ count }} minutes","seconds_param":"{{ count }} seconds","try_this_idea":"Try this idea","your_creations":"Your Creations","videos_left_param":"Videos left: {{ count }}","from_credits_param":"{{ count }}+ credits"},"current_promotion_banner":{"offer_expires_in":"One-time Offer Expires In..."},"shutterstock_promo_modal":{"title":"Get 15% off on Shutterstock Footage","subtitle":"Unleash your creativity"},"ai_images_generation_card":{"error":{"title":"We couldn’t create your image"},"loader":{"title":"Creating your image...","subtitle":"This may take up to a minute"}},"shutterstock_images_modal":{"title":"Get 10 free images on Shutterstock","subtitle":"Special offer for you"},"subscription_update_modal":{"error":"Something went wrong. Please try again.","upgrade_modal":{"title":"Upgrade plan","subtitle":"You are about to change your subscription plan. Please review the details below.","amount_due":"Amount due today","terms_html":"By clicking \"Confirm\", you agree to our \u003Ca href=\"/terms\" target=\"_blank\">Terms of Service\u003C/a>. Your new plan will start immediately.","confirm_btn":"Confirm and Pay","new_plan_label":"New plan","unused_credits":"Unused credits","prorations_label":"Prorations","current_plan_label":"Current plan"},"downgrade_modal":{"title":"Downgrade plan","terms_html":"By clicking \"Confirm\", you agree to our \u003Ca href=\"/terms\" target=\"_blank\">Terms of Service\u003C/a>. Your new plan will start at the next billing cycle."},"downgrade_applied_next_billing_period":"Your new plan will start at the next billing cycle"},"attribution_required_block":{"title":"Upgrade to avoid attribution","paragraph_1":"You can use this clip in unlimited projects, but you must credit the author. \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\" class=\"acu-link\">View license\u003C/a>.","paragraph_2":"To avoid attribution, upgrade to Coverr+"},"explore_shutterstock_modal":{"title":"Can’t find an videos you’re interested in?","description":"Try our partner, Shutterstock"},"request_password_reset_page":{"meta":{"title":"Request password reset | Coverr","description":"Send request to reset your password"}},"ai_generated_category_banner":{"text":"\u003Cp class=\"highlight-banner__text text-xl\">The \u003Cspan class=\"highlight-banner__gradient-text\">most advanced\u003C/span> AI Video model is now on \u003Cspan class=\"highlight-banner__gradient-text\">Coverr+\u003C/span>\u003C/p>","cta_copy":"Try Veo 3"},"ai_video_generator_landing_page":{"faq":[{"answer":"Creating an AI video is easy! Just choose whether you want to use text or an image, type your prompt, and click \"Generate.\" Our AI will turn your idea into a video in seconds.","question":"How to create the AI video?"},{"answer":"To get the best video results, type a clear and detailed prompt. If you’re unsure, use our built-in prompt enhancer tool to help refine your text or image for better video quality.","question":"How to prompt AI video generator?"},{"answer":"The text-to-video generator turns your written ideas into videos, while the image-to-video generator takes an image and adds movement. Both tools create videos, but the process is different. You can use the prompt enhancer with both features to improve the results and get the best video possible.","question":"What is the difference between text to video or image to video generator?"},{"answer":"You get 10 credits each month to create videos for free. If you need more, you can easily buy additional credits to keep making videos as needed.","question":"How many videos can I create?"}],"hero":{"title":"AI Video Generator","description":"Transform text or images into dynamic videos with ease. Use our built-in prompt enhancer for better results, all in one simple tool."},"uses":{"title":"How you can use AI videos","features":[{"icon":"shoppingBag","title":"AI video for business","description":"Create professional videos to promote your business, explain services, or share updates with your team"},{"icon":"broadcast","title":"AI video for advertisement & marketing","description":"Easily make eye-catching ads that grab attention and boost your brand with minimal effort"},{"icon":"userHeart","title":"AI video for social media","description":"Create fun, engaging videos to share on social media and connect with your audience"},{"icon":"hammer","title":"AI video for products","description":"Showcase your products in action, highlight features, and make them stand out with engaging videos"}],"description":"Create professional videos for any purpose: whether it’s showing products, promoting your brand, or connecting with your audience on social media."},"videos":{"features":[{"title":"Text to Video AI generator","description":"Write a prompt, and watch your words transform into a dynamic video"},{"title":"Image to Video AI generator","description":"Start with an image, and bring it to life with smooth motion"},{"title":"Enhance prompt with simple tool","description":"Get better results with a built-in assistant to refine your prompts"}]},"ai_input":{"title":"Create Your First Video Now","description":"Turn your ideas into videos in seconds. Click below to get started!"},"features":{"data":[{"image":"/assets/images/ai-video-generator-landing/features.jpeg","title":"Generate video from text","d