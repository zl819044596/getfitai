ee credits","description_download":"Sign up to download videos at higher resolution","description_workflow":"Create an account to submit your workflow for review","description_collect_audio":"Sign up and collect your favorite audio"},"ai_input":{"last":"Last","start":"Start","generate":"Generate","placeholder":"Describe video here","suggestions":"Suggestions","upload_images":"Upload images","image_required":"Image is required","suggestion_title":{"text_styles":"Text Styles","camera_styles":"Camera Styles","movement_types":"Movement Types","movement_speeds":"Movement Speeds","styles_aesthetics":"Styles & Aesthetics"},"recreate_placeholder":"Describe how you’d reimagine this video..."},"carousel":{"next":"Next","prev":"Previous"},"checkout":{"details":"Payment details","success":{"subtitle":"You have unlocked: ","sub_button":"Start creating","sub_value_1":"Full AI studio access and monthly AI credits","sub_value_2":"Members-only premium content","sub_value_3":"Access to 4K Footage & WAV Music","sub_value_4":"Ad-Free Experience","free_value_1":"2 Google Veo 2 Video Generations","free_value_2":"10 AI Images Generations","credit_button":"Keep creating ","title_credits":"Congratulations! You have successfully purchased additional AI credits","sub_button_pro":"Start exploring Coverr Pro","credits_value_1":"Additional credits for new generations with AI","title_free_trial":"Congratulation! You have successfully started your free trial","title_subscription":"Thank you for subscribing!","sub_button_free_trial":"Start Creating","title_subscription_pro":"Congratulation! You have successfully subscribed to Coverr Pro","description_subscription":"Your plan unlocks powerful AI tools, premium content, and creative workflows designed to help you turn ideas into stunning visuals—faster and with more freedom."},"summary":{"tax":"Tax (If applicable)","back":"Back","title":"Summary","billed":"Billed now","header":{"title":"Coverr Plus","title_pro":"Coverr Pro","ai_credits":"AI Credits",